{
  "opencollection": "1.0.0",
  "info": {
    "name": "Picsart GenAI Ads Audio API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Picsart-API-Key",
      "value": "{{X-Picsart-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Audio",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Adjust Audio",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://genai-api.picsart.io/v1/audio/adjust",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adjusts the input video's audio volume, allows to add a new audio channel and control its volume.\n"
        },
        {
          "info": {
            "name": "Extract Audio",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://genai-api.picsart.io/v1/export/audio",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Extract the input video's audio channel.\n"
        }
      ]
    }
  ],
  "bundled": true
}