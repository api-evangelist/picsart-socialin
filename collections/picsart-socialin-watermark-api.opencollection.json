{
  "opencollection": "1.0.0",
  "info": {
    "name": "Picsart GenAI Ads Watermark API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Picsart-API-Key",
      "value": "{{X-Picsart-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Watermark",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Add Watermark",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://genai-api.picsart.io/v1/watermark",
            "body": {
              "type": "multipart-form",
              "data": []
            }
          },
          "docs": "Add watermark to your image.\n"
        }
      ]
    }
  ],
  "bundled": true
}